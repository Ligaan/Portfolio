---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — Andrei Cuprinsu</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/experience">Experience</a>
        <a href="/projects">Projects</a>
        <a href="#contact">Contact</a>
        <a href="/Resume.pdf" target="_blank" rel="noopener">Resume</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <section id="contact" class="contact-wrap">
      <h2>CONTACT</h2>
      <p>
        My name is <span class="accent">Andrei Cuprinsu</span>, game development
        is my passion, the constant learning curve is what drives me to keep
        taking on the next challenge.
      </p>
      <div class="social-buttons">
        <a href="mailto:andrei.f.cuprinsu10@gmail.com" class="social-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M2 4h20v16H2V4zm2 2v.01L12 12l8-5.99V6H4zm16 12V8.24l-8 6-8-6V18h16z"/></svg>
          <span>Email</span>
        </a>
        <a href="https://github.com/Ligaan" target="_blank" rel="noopener" class="social-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.86c-2.78.62-3.37-1.37-3.37-1.37-.46-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.66.34-1.12.62-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.32.1-2.75 0 0 .84-.27 2.75 1.05a9.3 9.3 0 0 1 5 0c1.9-1.32 2.75-1.05 2.75-1.05.55 1.43.2 2.49.1 2.75.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.8-4.58 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
          <span>GitHub</span>
        </a>
        <a href="https://linkedin.com/in/andrei-cuprinsu-7b158b36b" target="_blank" rel="noopener" class="social-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </section>

    <footer>
      <p>Andrei Cuprinsu — Gameplay & Engine Programmer</p>
    </footer>

        <style>
      :global(html) {
        background-color: #14161a;
        scroll-behavior: smooth;
      }
      body {
        font-family: system-ui, sans-serif;
        max-width: 800px;
        margin: 0 auto;
        padding: 1.5rem;
        line-height: 1.5;
        background-color: #14161a;
        color: #e8e8e8;
      }
      nav {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 2rem;
      }
      nav a {
        text-decoration: none;
        font-weight: 600;
        color: #7dd3fc;
      }
      footer {
        margin-top: 3rem;
        opacity: 0.6;
        font-size: 0.9rem;
      }

      .contact-wrap {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid #2a2d33;
      }
      .accent {
        color: #2ecc71;
      }

      .social-buttons {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1.25rem;
        max-width: 220px;
      }
      .social-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 1.1rem;
        border: 1px solid #2ecc71;
        border-radius: 4px;
        color: #2ecc71 !important;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 0.9rem;
        transition: background 0.15s, color 0.15s;
      }
      .social-btn svg {
        flex-shrink: 0;
      }
      .social-btn:hover {
        background: #2ecc71;
        color: #14161a !important;
      }
    </style>

    <style is:global>
      .content-with-video {
        display: flex;
        gap: 2rem;
        align-items: flex-start;
        margin: 1.75rem 0;
      }

      .content-text {
        flex: 1 1 55%;
        min-width: 0;
      }

      .video-column {
        flex: 1 1 40%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        position: sticky;
        top: 1.5rem;
      }

      .video-figure {
        margin: 0;
      }

      .video-wrapper {
        width: 100%;
      }

      .video-wrapper video {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
      }

      .video-wrapper img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
      }

      .video-figure figcaption {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-muted, #9aa0a6);
      }

      @media (max-width: 700px) {
        .content-with-video {
          flex-direction: column;
        }

        .video-column {
          position: static;
        }
      }

      .media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 1.5rem;
        margin: 1.5rem 0;
      }

      .media-grid .video-figure {
        margin: 0;
      }

      .media-grid .video-wrapper img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
      }
    </style>
  </body>
</html>